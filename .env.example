# Copy to .env. Everything is optional; with nothing set the demo runs offline.

# ── Azure OpenAI (edges E04, E18). Unset = deterministic offline responder.
# To put the NaviStorm model gateway in front, point the endpoint at the gateway.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# ── MCP endpoints. To route an edge through the NaviStorm MCP proxy, override
# that server's URL. Default is http://$MCP_BASE_HOST:91xx/mcp
# MCP_WORKDAY_URL=http://navistorm-mcp-proxy:9900/workday/mcp
# MCP_SAP_URL=
# MCP_MES_URL=
# MCP_LMS_URL=
# MCP_CUOPT_URL=
# MCP_TEAMS_URL=
# MCP_POLICY_URL=
# MCP_ROSTER_URL=

# ── OpenTelemetry (GenAI semantic conventions). Unset = no export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Node tuning
TOOL_TIMEOUT_S=15
FORECAST_RETRY_DELAY_S=0.5
OPTIMIZER_MAX_ITER=4

# ── Manager Copilot business hours
COPILOT_TZ=Europe/London
COPILOT_HOURS=08:00-18:00
COPILOT_DAYS=0,1,2,3,4
